{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RcloneFlix",
  "version": "1.0.42",
  "identifier": "com.rcloneflix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RcloneFlix",
        "width": 1280,
        "height": 800,
        "minWidth": 340,
        "minHeight": 240,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost http://ipc.localhost:* http://127.0.0.1:* http://localhost:* http://asset.localhost asset: https: http:",
        "img-src": "'self' blob: data: http://127.0.0.1:* http://localhost:* http://asset.localhost asset: https: http:",
        "media-src": "'self' blob: data: http://127.0.0.1:* http://localhost:* http://asset.localhost asset: https: http:",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' https://fonts.gstatic.com",
        "script-src": "'self' 'unsafe-eval'",
        "frame-src": "'self' blob: data: https: http:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCACHE/**/*",
            "$APPDATA/**/*",
            "$LOCALDATA/**/*",
            "$TEMP/**/*",
            "$HOME/**/*",
            "$DOWNLOAD/**/*",
            "**/*"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "rclone",
          "libvlc5",
          "vlc-plugin-base",
          "webp-pixbuf-loader"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": [
      "rclone",
      "alist"
    ]
  }
}
